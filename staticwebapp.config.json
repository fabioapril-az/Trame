{
  "routes": [
    {
      "route": "/admin.html",
      "allowedRoles": ["editor"]
    },
    {
      "route": "/api/settings",
      "methods": ["GET"],
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/settings",
      "methods": ["PUT"],
      "allowedRoles": ["editor"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  }
}
